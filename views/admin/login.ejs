<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - Cafe QR System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { colors: { cafe: { dark: '#4A2C2A', medium: '#8B5E3C', light: '#D4A574', cream: '#F5E6D3', accent: '#E8913A' } } } } }</script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-cafe-cream via-cafe-light to-cafe-medium">
  
  <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-w-md mx-4 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-2 bg-cafe-accent"></div>
    
    <div class="text-center mb-8">
      <div class="inline-block p-4 rounded-full bg-cafe-cream/50 mb-4 shadow-sm">
        <span class="text-5xl">☕</span>
      </div>
      <h1 class="text-2xl font-bold text-cafe-dark">Cafe Admin Login</h1>
      <p class="text-gray-500 mt-2 text-sm">Sign in to manage your cafe operations</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 rounded mb-6 text-sm" role="alert">
        <p><%= error %></p>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="space-y-5">
      <div>
        <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fa-solid fa-user text-gray-400"></i>
          </div>
          <input type="text" name="username" id="username" required 
            class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg focus:ring-cafe-accent focus:border-cafe-accent transition-colors bg-gray-50 focus:bg-white" 
            placeholder="admin">
        </div>
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fa-solid fa-lock text-gray-400"></i>
          </div>
          <input type="password" name="password" id="password" required 
            class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg focus:ring-cafe-accent focus:border-cafe-accent transition-colors bg-gray-50 focus:bg-white" 
            placeholder="••••••••">
        </div>
      </div>

      <button type="submit" 
        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-cafe-medium hover:bg-cafe-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cafe-accent transition-colors mt-2">
        Sign In
      </button>
    </form>
  </div>

</body>
</html>
