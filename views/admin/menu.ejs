<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menu Management - Cafe QR System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { colors: { cafe: { dark: '#4A2C2A', medium: '#8B5E3C', light: '#D4A574', cream: '#F5E6D3', accent: '#E8913A' } } } } }</script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gray-50 min-h-screen flex">
  
  <%- include('../partials/admin-sidebar', { currentPage: 'menu' }) %>

  <main class="flex-1 ml-16 p-6 md:p-8">
    
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-cafe-dark">Menu Management</h1>
        <p class="text-gray-500 mt-1">Manage categories and menu items</p>
      </div>
      <div class="flex gap-3">
        <button onclick="openCategoryModal()" class="bg-white text-cafe-medium border border-cafe-medium hover:bg-cafe-cream px-4 py-2 rounded-lg shadow-sm font-medium transition-colors flex items-center gap-2">
          <i class="fa-solid fa-folder-plus"></i> Add Category
        </button>
        <button onclick="openItemModal()" class="bg-cafe-accent hover:bg-orange-500 text-white px-4 py-2 rounded-lg shadow-sm font-medium transition-colors flex items-center gap-2">
          <i class="fa-solid fa-plus"></i> Add Item
        </button>
      </div>
    </header>

    <!-- Categories Tabs -->
    <div class="mb-6 overflow-x-auto pb-2 scrollbar-hide">
      <div class="flex gap-2" id="category-tabs">
        <button class="px-5 py-2 rounded-full font-medium bg-cafe-dark text-white shadow-sm transition-colors whitespace-nowrap" data-category="all">All Items</button>
        <!-- Categories injected via JS -->
      </div>
    </div>

    <!-- Menu Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="menu-grid">
      <!-- Items injected via JS -->
      <div class="col-span-full text-center py-12 text-gray-400">
        <i class="fa-solid fa-spinner fa-spin text-3xl mb-3"></i>
        <p>Loading menu...</p>
      </div>
    </div>

  </main>

  <!-- Item Modal -->
  <div id="item-modal" class="fixed inset-0 bg-black/50 z-[100] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden transform transition-transform scale-95">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h2 class="text-xl font-bold text-cafe-dark" id="item-modal-title">Add Menu Item</h2>
        <button onclick="closeItemModal()" class="text-gray-400 hover:text-gray-600 transition-colors"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <form id="item-form" class="p-6 space-y-4">
        <input type="hidden" id="item-id">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
          <input type="text" id="item-name" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-cafe-accent focus:border-cafe-accent">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Price (₹)</label>
            <input type="number" id="item-price" min="0" step="0.01" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-cafe-accent focus:border-cafe-accent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
            <select id="item-category" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-cafe-accent focus:border-cafe-accent bg-white">
              <!-- Options injected via JS -->
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea id="item-desc" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-cafe-accent focus:border-cafe-accent"></textarea>
        </div>
        <div class="flex items-center gap-2 mt-4">
          <input type="checkbox" id="item-available" checked class="w-4 h-4 text-cafe-accent rounded focus:ring-cafe-accent">
          <label for="item-available" class="text-sm text-gray-700">Available for order</label>
        </div>
        <div class="pt-4 flex justify-end gap-3 border-t border-gray-100 mt-6">
          <button type="button" onclick="closeItemModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors font-medium">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-cafe-accent hover:bg-orange-500 text-white rounded-lg shadow-sm transition-colors font-medium">Save Item</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Category Modal -->
  <div id="category-modal" class="fixed inset-0 bg-black/50 z-[100] hidden flex items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm overflow-hidden transform transition-transform scale-95">
      <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h2 class="text-xl font-bold text-cafe-dark">Add Category</h2>
        <button onclick="closeCategoryModal()" class="text-gray-400 hover:text-gray-600 transition-colors"><i class="fa-solid fa-xmark text-xl"></i></button>
      </div>
      <form id="category-form" class="p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
          <input type="text" id="cat-name" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-cafe-accent focus:border-cafe-accent">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Sort Order</label>
          <input type="number" id="cat-order" value="0" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-cafe-accent focus:border-cafe-accent">
        </div>
        <div class="pt-4 flex justify-end gap-3 border-t border-gray-100 mt-6">
          <button type="button" onclick="closeCategoryModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors font-medium">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-cafe-accent hover:bg-orange-500 text-white rounded-lg shadow-sm transition-colors font-medium">Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-[200] flex flex-col gap-2"></div>

  <script src="/js/admin-menu.js"></script>
</body>
</html>
