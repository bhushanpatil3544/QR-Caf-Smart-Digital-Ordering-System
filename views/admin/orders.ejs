<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Orders - Cafe QR System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwind.config = { theme: { extend: { colors: { cafe: { dark: '#4A2C2A', medium: '#8B5E3C', light: '#D4A574', cream: '#F5E6D3', accent: '#E8913A' } } } } }</script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gray-50 min-h-screen flex">
  
  <%- include('../partials/admin-sidebar', { currentPage: 'orders' }) %>

  <main class="flex-1 ml-16 p-6 md:p-8 flex flex-col h-screen overflow-hidden">
    
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 shrink-0">
      <div>
        <h1 class="text-3xl font-bold text-cafe-dark flex items-center gap-3">
          Live Orders
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
          </span>
        </h1>
        <p class="text-gray-500 mt-1">Real-time incoming orders</p>
      </div>
      <div class="flex gap-2 p-1 bg-gray-200/50 rounded-lg" id="order-filters">
        <button class="px-4 py-2 rounded-md text-sm font-medium bg-white shadow-sm text-cafe-dark" data-filter="all">All Active</button>
        <button class="px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-cafe-dark hover:bg-gray-200 transition-colors" data-filter="pending">Pending</button>
        <button class="px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-cafe-dark hover:bg-gray-200 transition-colors" data-filter="confirmed">Confirmed</button>
        <button class="px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-cafe-dark hover:bg-gray-200 transition-colors" data-filter="preparing">Preparing</button>
      </div>
    </header>

    <!-- Orders Grid Area -->
    <div class="flex-1 overflow-y-auto pr-2 pb-8 custom-scrollbar">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="orders-grid">
        <!-- Orders injected via JS -->
        <div class="col-span-full text-center py-12 text-gray-400" id="orders-loading">
          <i class="fa-solid fa-spinner fa-spin text-3xl mb-3"></i>
          <p>Loading live orders...</p>
        </div>
      </div>
    </div>

  </main>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-[200] flex flex-col gap-2"></div>

  <script src="/js/admin-orders.js"></script>
</body>
</html>
